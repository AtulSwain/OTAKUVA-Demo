# local dev database (SQLite). Canonical data lives in the DB, not in git.
# Back this up separately — git is not a backup for a live database.
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# scratch / local working notes
/scratch

# runtime user-uploaded media (avatars, banners, community icons).
# User data, not source. Production target is Cloudflare R2 (§46-§54).
/public/uploads
