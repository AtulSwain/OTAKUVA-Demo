# ANILOG Environment Configuration Example

# Database (PostgreSQL - Phase 2)
DATABASE_URL="postgresql://user:password@localhost:5432/anilog?schema=public"

# External Data Provider (Jikan API - Phase 3)
JIKAN_BASE_URL="https://api.jikan.moe/v4"

# AniList GraphQL endpoint and optional token
ANILIST_BASE_URL="https://graphql.anilist.co"
# Optional: provide an AniList API token if available (for higher rate limits / private data)
ANILIST_TOKEN=""

# Preferred provider: "jikan" or "anilist". If empty, provider selection is automatic.
ANILOG_PROVIDER=""

# Authentication Secrets (Phase 5)
AUTH_SECRET="your-32-character-random-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# RBAC bootstrap: comma-separated emails to auto-promote to SUPER_ADMIN on
# their next login/registration. This is the only way to create the first
# SUPER_ADMIN account (there's no other way to get an admin without direct
# DB access). Once at least one SUPER_ADMIN exists, further role changes go
# through PATCH /api/admin/users/:id/role instead of this env var.
OTAKUVA_SUPER_ADMIN_EMAILS=""

# Cloudflare R2 Production Media Storage
# Object storage for authenticated user profile media (avatars and banners)
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="0633c7571e5c9ccb6f49c6f197b707c0"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="otakuva-media"
R2_ENDPOINT="https://0633c7571e5c9ccb6f49c6f197b707c0.r2.cloudflarestorage.com"
MEDIA_PUBLIC_URL="https://media.otakuva.com"


# Optional: GIF search in comments (GIPHY). Server-side only — never prefix
# with NEXT_PUBLIC_. Without it the GIF picker says search isn't set up and
# people can still attach a GIF by uploading the file.
GIPHY_API_KEY=""
